{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview",
      "startServerReadyPattern": "localhost:4321",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/es/",
        "http://localhost:4321/services/",
        "http://localhost:4321/es/servicios/",
        "http://localhost:4321/about/",
        "http://localhost:4321/es/sobre-mi/",
        "http://localhost:4321/contact/",
        "http://localhost:4321/es/contacto/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:accessibility": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lighthouse"
    }
  }
}
