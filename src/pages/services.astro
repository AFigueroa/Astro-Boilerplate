---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Services" description="Services offered.">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-serif text-3xl font-semibold text-brand-900">Services</h1>
    <ul class="mt-8 space-y-6">
      {
        services.map((service) => (
          <li>
            <h2 class="text-xl font-medium text-brand-900">{service.data.title}</h2>
            <p class="mt-1 text-brand-600">{service.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
