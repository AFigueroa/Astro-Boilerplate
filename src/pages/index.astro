---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Home"
  description="Welcome to the site — replace this description with your own."
>
  <section class="mx-auto max-w-6xl px-4 py-24 text-center">
    <h1 class="font-serif text-4xl font-semibold text-brand-900 sm:text-5xl">
      Astro + Tailwind Boilerplate
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-brand-600">
      Replace this hero with your client's content. Layout, SEO, and nav are
      wired up in <code>src/layouts/Layout.astro</code>.
    </p>
  </section>
</Layout>
