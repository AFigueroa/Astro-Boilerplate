---
import { env } from "@/env/config";
import { type Locale, localeMeta, localizedPath, type RouteKey } from "@/i18n/routes";
import { useTranslations } from "@/i18n/ui";

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const t = useTranslations(locale);
const otherLocale: Locale = locale === "en" ? "es" : "en";

const nav: { key: RouteKey; label: string }[] = [
  { key: "home", label: t("nav.home") },
  { key: "services", label: t("nav.services") },
  { key: "about", label: t("nav.about") },
  { key: "contact", label: t("nav.contact") },
];
---

<header class="border-b border-brand-100">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href={localizedPath("home", locale)} class="font-serif text-lg font-semibold text-brand-900">
      {env.PUBLIC_SITE_NAME}
    </a>
    <nav aria-label={t("nav.label")}>
      <ul class="flex flex-wrap items-center gap-6 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={localizedPath(item.key, locale)}
                aria-current={item.key === routeKey ? "page" : undefined}
                class="text-brand-600 hover:text-brand-900 aria-[current=page]:font-semibold aria-[current=page]:text-brand-900"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={localizedPath(routeKey, otherLocale)}
            hreflang={localeMeta[otherLocale].hreflang}
            lang={localeMeta[otherLocale].hreflang}
            aria-label={t("lang.switchLabel")}
            class="rounded border border-brand-100 px-2 py-1 text-brand-600 hover:text-brand-900"
          >
            {t("lang.switch")}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
