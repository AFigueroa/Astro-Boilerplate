---
import type { Locale } from "@/i18n/routes";
import Layout from "@/layouts/Layout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Placeholder copy until Antonio's bio arrives (plan.md §11).
const copy = {
  en: {
    title: "About Antonio Figueroa",
    description: "Founder of Batey Labs. Senior full-stack engineer with 10+ years of experience.",
    heading: "About",
    body: "Founder of Batey Labs. Senior full-stack engineer with 10+ years building secure, accessible web applications.",
  },
  es: {
    title: "Sobre Antonio Figueroa",
    description:
      "Fundador de Batey Labs. Ingeniero full-stack sénior con más de 10 años de experiencia.",
    heading: "Sobre mí",
    body: "Fundador de Batey Labs. Ingeniero full-stack sénior con más de 10 años creando aplicaciones web seguras y accesibles.",
  },
}[locale];
---

<Layout title={copy.title} description={copy.description} locale={locale} routeKey="about">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-serif text-3xl font-semibold text-brand-900">{copy.heading}</h1>
    <p class="mt-4 text-brand-600">{copy.body}</p>
  </section>
</Layout>
