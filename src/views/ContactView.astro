---
import ContactForm from "@/components/ContactForm.astro";
import type { Locale } from "@/i18n/routes";
import Layout from "@/layouts/Layout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  en: { title: "Contact", description: "Start a project with Batey Labs." },
  es: { title: "Contacto", description: "Comienza un proyecto con Batey Labs." },
}[locale];
---

<Layout title={copy.title} description={copy.description} locale={locale} routeKey="contact">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-serif text-3xl font-semibold text-brand-900">{copy.title}</h1>
    <div class="mt-8">
      <ContactForm locale={locale} />
    </div>
  </section>
</Layout>
