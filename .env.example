# Copy to .env and fill in per project. All PUBLIC_ vars are exposed to the
# client bundle — never put secrets behind the PUBLIC_ prefix.

PUBLIC_SITE_NAME="Batey Labs"
PUBLIC_CONTACT_EMAIL="antonio.figueroa@bateylabs.com"
PUBLIC_CONTACT_FORM_ENDPOINT=""
# "false" adds noindex to every page (private preview). "true" only at public launch.
PUBLIC_INDEXABLE="false"
